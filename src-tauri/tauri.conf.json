{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life Kanban",
  "version": "0.2.0",
  "identifier": "com.lifekanban.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Life Kanban",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "A playful, local Kanban for your Windows desktop",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
